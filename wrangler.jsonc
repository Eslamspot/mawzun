{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mawzun-project",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
